<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged only into the opt-in VertMatch build (-Popenvitals.vertmatch=true). This is the one
    place OpenVitals asks for INTERNET: the default build never sees this file and keeps removing
    the permission (app/src/main/AndroidManifest.xml, "offline-only").
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="replace" />

    <application>
        <!-- singleTask: the browser's redirect comes back to the running screen (onNewIntent). -->
        <activity
            android:name=".features.vertmatch.VertMatchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenVitals">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="vertmatch"
                    android:path="/callback"
                    android:scheme="${applicationId}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
